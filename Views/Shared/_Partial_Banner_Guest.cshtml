<div class="container-fluid p-0">

    <div id="bannerGuest" class="carousel slide" data-bs-ride="carousel" data-bs-interval="3000">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#bannerGuest" data-bs-slide-to="0" class="active"></button>
            <button type="button" data-bs-target="#bannerGuest" data-bs-slide-to="1"></button>
            <button type="button" data-bs-target="#bannerGuest" data-bs-slide-to="2"></button>
        </div>

        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="@Url.Content("~/Content/Img/banner1.jpg")" class="d-block w-100" style="height:400px; object-fit:cover;" />
            </div>
            <div class="carousel-item">
                <img src="@Url.Content("~/Content/Img/banner2.jpg")" class="d-block w-100" style="height:400px; object-fit:cover;" />
            </div>
            <div class="carousel-item">
                <img src="@Url.Content("~/Content/Img/banner3.jpg")" class="d-block w-100" style="height:400px; object-fit:cover;" />
            </div>
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#bannerGuest" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#bannerGuest" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>
    </div>
</div>
<script src="~/Content/Scripts/bootstrap.bundle.min.js"></script>
