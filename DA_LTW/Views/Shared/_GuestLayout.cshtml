@* Layout dành cho khách hàng *@
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - Guest | SmartRestaurant</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="~/Content/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/css/admin.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
</head>
<body>
    <div class="d-flex" id="wrapper">

        <!-- Nội dung -->
        <div id="page-content-wrapper" class="flex-grow-1">
            <nav class="navbar navbar-light bg-light border-bottom shadow-sm">
                <div class="container-fluid">
                    <span class="navbar-text">Xin chào, @Session["Username"] (@Session["UserRole"])</span>
                    <a href="/TaiKhoan/DangXuat" class="btn btn-outline-danger btn-sm">Đăng xuất</a>
                </div>
            </nav>

            <div class="container-fluid p-4">
                @RenderBody()
            </div>

            <footer class="bg-light text-center py-2 border-top mt-4">
                <span class="text-muted small">
                    © @DateTime.Now.Year SmartRestaurant | Nhà hàng thông minh
                </span>
            </footer>
        </div>
    </div>

    <script src="~/Content/Scripts/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
