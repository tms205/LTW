@{
    Layout = "~/Views/Shared/_LayoutDoAn.cshtml";
}




/* Header */
header img {
    transition: transform 0.3s;
}

    header img:hover {
        transform: scale(1.05);
    }

/* Footer */
footer a:hover {
    text-decoration: underline;
}

footer .bi {
    color: #f8d210;
    margin-right: 5px;
}

#bannerGuest {
    max-width: 100%;           /* Chiều rộng tối đa bằng chiều rộng container cha */
    overflow: hidden;
    border-radius: 8px;        /* Bo góc nhẹ cho banner */
    box-shadow: 0 4px 15px rgba(0,0,0,0.2); /* Bóng đổ nhẹ tạo chiều sâu */
}

#bannerGuest .carousel-inner {
    height: 220px;             /* Chiều cao cố định */
    border-radius: 8px;        /* Bo góc tương tự */
}

#bannerGuest .carousel-item img {
    height: 180px;
    object-fit: cover;         /* Ảnh phủ đầy và không méo */
    border-radius: 8px;        /* Bo góc */
    transition: transform 0.5s ease; /* Hiệu ứng mượt khi chuyển ảnh */
}

#bannerGuest .carousel-item.active img {
    transform: scale(1);       /* Ảnh đang hiển thị bình thường */
}

#bannerGuest .carousel-item-next img,
#bannerGuest .carousel-item-prev img {
    transform: scale(1.05);    /* Ảnh kế tiếp/phía trước hơi phóng to nhẹ khi animation */
}

/* Điều chỉnh vị trí và màu sắc nút điều hướng */
#bannerGuest .carousel-control-prev-icon,
#bannerGuest .carousel-control-next-icon {
    filter: drop-shadow(0 0 2px rgba(0,0,0,0.7));
    background-color: rgba(255, 255, 255, 0.7);
    border-radius: 50%;
}

/* Nút chuyển ảnh nhỏ gọn hơn và rõ */
#bannerGuest .carousel-indicators button {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.7);
    border: none;
    transition: background-color 0.3s ease;
}

#bannerGuest .carousel-indicators .active {
    background-color: #0d6efd; /* Màu xanh bootstrap cho dot active */
}

header .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

header nav ul.nav {
    display: flex;
    align-items: center;
    gap: 1rem;
}

.cart-badge {
    background-color: #dc3545;
    color: #fff;
    border-radius: 50%;
    font-size: 0.75rem;
    padding: 0.15rem 0.5rem;
    margin-left: 0.3rem;
    vertical-align: top;
    display: inline-block;
}
